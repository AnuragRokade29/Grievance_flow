{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/amc-grievance-v1",
  "name": "Amravati Municipal Grievance Flow",
  "short_name": "AMC Grievance",
  "description": "Official Amravati Municipal Corporation Civic Grievance Redressal and Public Tracking Portal.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f8fafc",
  "theme_color": "#059669",
  "categories": ["government", "utilities", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Snap & Report Grievance",
      "short_name": "Report",
      "description": "Snap a photo and report a civic grievance immediately",
      "url": "./index.html?action=report",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Live Ticket Tracker",
      "short_name": "Tracker",
      "description": "View live municipal status of your reported grievances",
      "url": "./index.html?view=tracker",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Municipal Officer Desk",
      "short_name": "Admin Desk",
      "description": "Manage civic queues and assign complaints",
      "url": "./admin.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
